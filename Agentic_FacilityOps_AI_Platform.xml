  <architecture_diagram>
    <description>Visualizes how autonomous AI agents collaborate to manage and optimize facility operations for Corporate Offices, IT Parks, Universities, and Hospitals.</description>

    <facility_data_sources>
      <source>IoT Sensors</source>
      <source>HVAC Systems</source>
      <source>Smart Utility Meters</source>
      <source>CCTV Cameras</source>
      <source>Access Control Systems</source>
      <source>Occupancy Sensors</source>
      <source>Asset Management System</source>
      <source>Maintenance Records</source>
    </facility_data_sources>

    <agents>
      <agent name="Energy Agent">
        <function>Energy Monitoring</function>
        <function>Utility Analytics</function>
        <function>Energy Optimization</function>
      </agent>
      <agent name="Maintenance Agent">
        <function>Asset Health Monitoring</function>
        <function>Predictive Maintenance</function>
        <function>Work Order Recommendations</function>
      </agent>
      <agent name="Occupancy Agent">
        <function>Space Utilization</function>
        <function>Occupancy Analytics</function>
        <function>Capacity Forecasting</function>
      </agent>
      <agent name="Security Agent">
        <function>Access Monitoring</function>
        <function>CCTV Event Analysis</function>
        <function>Incident Detection</function>
      </agent>
      <agent name="Cost Optimization Agent">
        <function>Operational Cost Analysis</function>
        <function>Resource Optimization</function>
        <function>Budget Monitoring</function>
      </agent>
    </agents>

    <central_component name="Facility Intelligence Engine">
      <function>Aggregate Insights</function>
      <function>Correlate Events</function>
      <function>Generate Recommendations</function>
      <function>Coordinate Agent Actions</function>
    </central_component>

    <shared_services>
      <service>PostgreSQL Database</service>
      <service>Time-Series Data Warehouse</service>
      <service>Audit Logs</service>
      <service>Historical Facility Data</service>
