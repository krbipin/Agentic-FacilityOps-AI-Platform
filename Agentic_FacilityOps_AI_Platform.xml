      <output>Energy Dashboard</output>
      <output>Maintenance Dashboard</output>
      <output>Security Dashboard</output>
      <output>Executive Dashboard</output>
      <output>Mobile App</output>
      <output>Email Alerts</output>
      <output>SMS Notifications</output>
      <output>Teams Notifications</output>
