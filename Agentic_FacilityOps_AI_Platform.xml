    <connection_legend>
      <connection_type name="Data Flow" symbol="-->"/>
      <connection_type name="Bidirectional Interaction" symbol="&lt;-->"/>
      <connection_type name="Data Persistence / Access" symbol="-.->"/>
    </connection_legend>
  </architecture_diagram>

  <database_schema>
    <description>Entity-relationship schema for the Agentic FacilityOps AI Database.</description>

    <entity name="FACILITIES">
      <field name="facility_id" type="PK"/>
      <field name="facility_name"/>
      <field name="facility_type"/>
      <field name="location"/>
    </entity>

    <entity name="ASSETS">
      <field name="asset_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="asset_name"/>
      <field name="asset_type"/>
      <field name="status"/>
    </entity>

    <entity name="MAINTENANCE_RECORDS">
      <field name="maintenance_id" type="PK"/>
      <field name="asset_id" type="FK" references="ASSETS.asset_id"/>
      <field name="issue_type"/>
      <field name="maintenance_date"/>
      <field name="status"/>
    </entity>

    <entity name="ENERGY_USAGE">
      <field name="energy_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="timestamp"/>
      <field name="electricity_usage"/>
      <field name="water_usage"/>
    </entity>

    <entity name="OCCUPANCY_RECORDS">
      <field name="occupancy_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="zone"/>
      <field name="occupancy_count"/>
      <field name="timestamp"/>
    </entity>

    <entity name="SECURITY_EVENTS">
      <field name="event_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="event_type"/>
      <field name="severity"/>
      <field name="timestamp"/>
    </entity>

    <entity name="COST_REPORTS">
      <field name="report_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="category"/>
      <field name="amount"/>
      <field name="report_date"/>
    </entity>

    <entity name="ALERTS">
      <field name="alert_id" type="PK"/>
      <field name="facility_id" type="FK" references="FACILITIES.facility_id"/>
      <field name="alert_type"/>
      <field name="severity"/>
      <field name="created_at"/>
    </entity>

    <relationships>
      <relationship from="FACILITIES" to="ASSETS" cardinality="1:N"/>
      <relationship from="ASSETS" to="MAINTENANCE_RECORDS" cardinality="1:N"/>
      <relationship from="FACILITIES" to="ENERGY_USAGE" cardinality="1:N"/>
      <relationship from="FACILITIES" to="OCCUPANCY_RECORDS" cardinality="1:N"/>
      <relationship from="FACILITIES" to="SECURITY_EVENTS" cardinality="1:N"/>
      <relationship from="FACILITIES" to="COST_REPORTS" cardinality="1:N"/>
      <relationship from="FACILITIES" to="ALERTS" cardinality="1:N"/>
    </relationships>
  </database_schema>

</project>
