# --- Clerk (https://dashboard.clerk.com) ---
# Copy to .env.local for local dev; set the same values in Vercel/Render dashboards.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Clerk redirect URLs ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_OUT_REDIRECT_URL=/

# --- Backend ---
# Local dev default: http://127.0.0.1:8000
# Vercel: set to your Render backend URL, e.g. https://facilityops-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# --- Backend database (backend/.env — see backend/.env.example) ---
# The backend reads its own env file at backend/.env. The one key it needs is:
#
#   DATABASE_URL=postgresql://user:password@host/database   (Neon PostgreSQL)
#
# If DATABASE_URL is unset the backend falls back to a local SQLite file at
# backend/data/facilityops.db (PostgreSQL-only SQL features are used by some
# agents, so a real PostgreSQL/Neon connection is recommended).
# NOTE: never commit the real DATABASE_URL — it lives only in backend/.env.
