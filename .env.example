# --- Clerk (https://dashboard.clerk.com) ---
# Copy to .env.local for local dev; set the same values in Vercel/Render dashboards.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Clerk redirect URLs ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_OUT_REDIRECT_URL=/

# --- Backend ---
# Local dev default: http://127.0.0.1:8000
# Vercel: set to your Render backend URL, e.g. https://facilityops-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
